# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL=postgresql://siaga:GANTI_PASSWORD@localhost:5432/siagamesin
MQTT_HOST=localhost

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database password inside Docker (optional, default siaga_local)
POSTGRES_PASSWORD=

# Allowed dashboard origins, comma-separated
CORS_ORIGINS=http://localhost:3000

# Stop detection
STOP_CURRENT_A=0.3
STOP_SECONDS=5

# Machine sources whose early warnings go to Telegram (live,replay)
ALERT_NOTIFY_SOURCES=live,replay

# AI endpoint on AMD (from role 3); empty = mock mode
AI_BASE_URL=
AI_API_KEY=
# Confidence below this is marked "Needs review"
CLASSIFY_REVIEW_BELOW=0.6

# Shift start times (WIB)
SHIFT_STARTS=06:00,14:00,22:00
