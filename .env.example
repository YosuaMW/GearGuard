# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL=postgresql://siaga:GANTI_PASSWORD@localhost:5432/siagamesin
MQTT_HOST=localhost
# MQTT login (must match deploy/passwd, see docs/raspi-setup.md)
MQTT_USERNAME=siaga
MQTT_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database password inside Docker (optional, default siaga_local)
POSTGRES_PASSWORD=

# Allowed dashboard origins, comma-separated
CORS_ORIGINS=http://localhost:3000

# Stop detection
STOP_CURRENT_A=0.3
STOP_SECONDS=5

# Machine sources whose early warnings go to Telegram
# live = only the real rig (quiet), live,replay = simulator machines too
ALERT_NOTIFY_SOURCES=live

# AI service (role 3, the `ai` container). Empty AI_BASE_URL = mock mode
AI_BASE_URL=http://ai:8001
# must equal AI_SERVICE_KEY in AI/.env (internal key, not the Token Factory key)
AI_API_KEY=
# Which machine sources get an AI explanation on new alerts (live | live,replay)
EXPLAIN_SOURCES=live

# Speech-to-text (the `stt` container): key must equal WHISPER_API_KEY in AI/.env
STT_API_KEY=
# Voice note language: en | id | empty = auto-detect
STT_LANGUAGE=en
# Confidence below this is marked "Needs review"
CLASSIFY_REVIEW_BELOW=0.6

# Shift start times (WIB)
SHIFT_STARTS=06:00,14:00,22:00

# Data gap: if a machine sends nothing for this long, an open stop is closed at its last data
DATA_GAP_SECONDS=30

# Anomaly detection (z = how many 'normal spreads' a sensor is away from its baseline)
# average over the last N seconds, alert when z >= Z_ALERT for CONFIRM_S seconds, clear when z < Z_CLEAR
ANOMALY_WINDOW_S=10
ANOMALY_Z_ALERT=3
ANOMALY_CONFIRM_S=5
ANOMALY_Z_CLEAR=2
