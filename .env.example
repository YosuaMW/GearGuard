# Salin jadi .env lalu isi. JANGAN commit .env.
DATABASE_URL=postgresql://siaga:GANTI_PASSWORD@localhost:5432/siagamesin
MQTT_HOST=localhost

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Origin dashboard yang diizinkan, pisahkan dengan koma
CORS_ORIGINS=http://localhost:3000

# Deteksi mesin berhenti
STOP_CURRENT_A=0.3
STOP_SECONDS=5

# Sumber mesin yang peringatannya dikirim ke Telegram (live,replay)
ALERT_NOTIFY_SOURCES=live,replay

# Endpoint AI di AMD (dari peran 3)
AI_BASE_URL=
AI_API_KEY=
