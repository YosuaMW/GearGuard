# Copy to AI/.env (NEVER commit). See docs/raspi-setup.md section D.

# AMD Token Factory team key (rc-...). Only lives here, never in the backend .env
RADEON_API_KEY=
# Internal key the backend uses to call this service (= AI_API_KEY in the main .env)
AI_SERVICE_KEY=

# Speech-to-text: Whisper in the `stt` container (or an AMD GPU instance, OpenAI-compatible)
WHISPER_BASE_URL=http://stt:9000/v1
# = STT_API_KEY in the main .env
WHISPER_API_KEY=
# Label shown on the dashboard's "Running on AMD" page
WHISPER_MODEL=faster-whisper-base-pi

# Time limits (seconds); the backend waits 30 s for transcribe/classify and 70 s for explain
TRANSCRIBE_BUDGET=28
CLASSIFY_BUDGET=25
EXPLAIN_BUDGET=55
